{
  "week": 1,
  "title": "环境搭建 + Linux基础",
  "tasks": [
    {
      "id": "w1t1",
      "title": "安装Linux环境（WSL2或虚拟机）",
      "type": "setup",
      "time": "1-2小时",
      "guide": {
        "objective": "在Windows上安装WSL2 Ubuntu环境",
        "steps": [
          {
            "step": 1,
            "action": "启用WSL功能",
            "command": "以管理员身份运行PowerShell，执行：\nwsl --install",
            "expected": "系统会自动下载并安装WSL2和Ubuntu",
            "troubleshooting": "如果失败，手动启用：dism.exe /online /enable-feature /featurename:Microsoft-Windows-Subsystem-Linux /all /norestart"
          },
          {
            "step": 2,
            "action": "重启电脑",
            "why": "启用WSL功能需要重启"
          },
          {
            "step": 3,
            "action": "打开Ubuntu",
            "command": "在开始菜单搜索Ubuntu并打开",
            "expected": "首次启动会要求设置用户名和密码"
          },
          {
            "step": 4,
            "action": "更新系统",
            "command": "sudo apt update && sudo apt upgrade -y",
            "why": "确保系统包是最新的"
          },
          {
            "step": 5,
            "action": "测试安装",
            "command": "ls -la\npwd\nwhoami",
            "expected": "能正常显示文件列表、当前路径、用户名"
          }
        ],
        "success_criteria": "能够打开终端并执行基本命令",
        "common_issues": [
          {
            "issue": "wsl --install失败",
            "solution": "检查Windows版本（需要Windows 10 19041+或Windows 11），手动启用虚拟化"
          },
          {
            "issue": "Ubuntu启动报错",
            "solution": "在BIOS中启用虚拟化技术（Intel VT-x或AMD-V）"
          }
        ]
      }
    },
    {
      "id": "w1t2",
      "title": "完成20个基础命令练习",
      "type": "practice",
      "time": "2-3小时",
      "guide": {
        "objective": "掌握20个最常用的Linux命令",
        "commands": [
          {
            "command": "ls",
            "usage": "ls -la",
            "purpose": "列出文件和目录",
            "example": "ls -la ~/  # 查看家目录所有文件（包括隐藏文件）",
            "practice": "列出当前目录所有文件，包括详细信息"
          },
          {
            "command": "cd",
            "usage": "cd <directory>",
            "purpose": "切换目录",
            "example": "cd /home\ncd ..\ncd ~",
            "practice": "切换到家目录，再切换到/tmp，最后返回家目录"
          },
          {
            "command": "pwd",
            "usage": "pwd",
            "purpose": "显示当前路径",
            "example": "pwd",
            "practice": "显示当前所在的完整路径"
          },
          {
            "command": "mkdir",
            "usage": "mkdir <directory>",
            "purpose": "创建目录",
            "example": "mkdir test\nmkdir -p a/b/c  # 创建多层目录",
            "practice": "创建目录结构：~/bioinfo/{data,scripts,results}"
          },
          {
            "command": "touch",
            "usage": "touch <file>",
            "purpose": "创建空文件",
            "example": "touch test.txt",
            "practice": "创建3个空文件：file1.txt, file2.txt, file3.txt"
          },
          {
            "command": "cp",
            "usage": "cp <source> <dest>",
            "purpose": "复制文件",
            "example": "cp file1.txt file2.txt\ncp -r dir1 dir2  # 复制目录",
            "practice": "复制file1.txt为file1_backup.txt"
          },
          {
            "command": "mv",
            "usage": "mv <source> <dest>",
            "purpose": "移动或重命名",
            "example": "mv old.txt new.txt\nmv file.txt /tmp/",
            "practice": "将file1.txt重命名为data.txt"
          },
          {
            "command": "rm",
            "usage": "rm <file>",
            "purpose": "删除文件",
            "example": "rm file.txt\nrm -r dir/  # 删除目录",
            "practice": "删除file2.txt（注意：删除前确认）"
          },
          {
            "command": "cat",
            "usage": "cat <file>",
            "purpose": "查看文件内容",
            "example": "cat file.txt",
            "practice": "查看/etc/os-release文件内容"
          },
          {
            "command": "head",
            "usage": "head -n <lines> <file>",
            "purpose": "查看文件前几行",
            "example": "head -20 file.txt",
            "practice": "查看文件前10行"
          }
        ],
        "practice_tasks": [
          "创建目录结构：~/bioinfo/{data,scripts,results,notes}",
          "在data目录创建test.txt文件",
          "复制test.txt到results目录",
          "重命名results/test.txt为output.txt",
          "查看output.txt内容"
        ]
      }
    },
    {
      "id": "w1t3",
      "title": "完成测序数据接收场景任务",
      "type": "project",
      "time": "1-2小时",
      "guide": {
        "scenario": {
          "background": "你是生信公司的实习生，测序公司刚发来10个样本的RNA-seq数据",
          "deadline": "1小时内完成数据接收和初步检查",
          "deliverable": "数据整理报告"
        },
        "steps": [
          {
            "step": 1,
            "task": "创建项目目录",
            "command": "mkdir -p ~/project_rnaseq/{raw_data,clean_data,results,scripts,docs}",
            "why": "规范的目录结构是团队协作的基础"
          },
          {
            "step": 2,
            "task": "模拟下载数据",
            "command": "cd ~/project_rnaseq/raw_data\nfor i in {1..10}; do touch sample${i}_R1.fastq sample${i}_R2.fastq; done",
            "why": "实际工作中会从服务器下载，这里用空文件模拟"
          },
          {
            "step": 3,
            "task": "检查文件数量",
            "command": "ls -1 | wc -l",
            "expected": "应该有20个文件（10个样本 x 2个文件）",
            "why": "确认数据完整性"
          },
          {
            "step": 4,
            "task": "生成文件清单",
            "command": "ls -lh > ../docs/file_list.txt",
            "why": "记录接收的文件信息"
          },
          {
            "step": 5,
            "task": "创建README",
            "command": "cat > ../README.md << 'EOF'\n# RNA-seq Project\n\n## 数据信息\n- 样本数：10\n- 测序类型：PE150\n- 数据接收日期：2024-01-01\n\n## 目录结构\n- raw_data/: 原始数据\n- clean_data/: 质控后数据\n- results/: 分析结果\n- scripts/: 分析脚本\n- docs/: 文档\nEOF",
            "why": "项目文档是必需的"
          }
        ],
        "deliverable": {
          "files": [
            "README.md",
            "docs/file_list.txt"
          ],
          "report": "向主管汇报：已接收10个样本共20个文件，目录结构已建立"
        }
      }
    }
  ]
}
